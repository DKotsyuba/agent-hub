{
  "name": "agent-hub",
  "private": true,
  "version": "0.3.10",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.contract.json",
    "build": "npm run typecheck && vite build --configLoader native",
    "terminal": "npm run start --workspace agent-hub-terminal --",
    "terminal:build": "npm run build:binary --workspace agent-hub-terminal",
    "observer:build": "cargo build --offline --locked --manifest-path server/observer/Cargo.toml",
    "server:build": "npm run build --workspace agent-hub-server",
    "web:build": "vite build --configLoader native",
    "build:release": "node scripts/release.mjs build",
    "preview": "vite preview --configLoader native --host 127.0.0.1 --port 4173 --strictPort",
    "test:browser": "node scripts/browser-check.mjs",
    "test:contract": "bun test --no-install packages/domain/test packages/client/test packages/view-model/test src/web/test",
    "fixtures": "bun --no-install packages/client/fixtures/serve.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.21",
    "@tauri-apps/api": "2.12.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "webdriverio": "10.2.0"
  },
  "workspaces": [
    "server",
    "terminal",
    "packages/*"
  ]
}
