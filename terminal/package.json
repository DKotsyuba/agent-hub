{
  "name": "agent-hub-terminal",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.4.0",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "start": "bun --no-install src/main.ts",
    "build:binary": "bun scripts/build-binary.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000",
    "test:node": "node --experimental-ffi --test test/*.test.ts"
  },
  "dependencies": {
    "@opentui/core": "0.8.2",
    "string-width": "7.2.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
